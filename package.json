{
  "name": "orbit",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "nx run desktop:dev",
    "dev:desktop": "nx run desktop:dev",
    "dev:landing": "nx run landing:dev",
    "build": "nx run-many -t build",
    "build:desktop": "nx run desktop:build",
    "build:landing": "nx run landing:build",
    "bundle:themes": "node scripts/bundle-theme-artwork.mjs",
    "optimize:themes": "node scripts/optimize-theme-artwork.mjs",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:desktop": "nx run desktop:typecheck",
    "typecheck:landing": "nx run landing:typecheck",
    "test:unit": "nx run-many -t test:unit",
    "test:unit:desktop": "nx run desktop:test:unit",
    "test:unit:landing": "nx run landing:test:unit",
    "test:rust": "nx run desktop:test:rust",
    "test:e2e": "nx run desktop:test:e2e",
    "test:e2e:ui": "nx run desktop:test:e2e:ui",
    "tauri:dev": "nx run desktop:tauri:dev",
    "tauri:build": "nx run desktop:tauri:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:macos": "bash scripts/release-macos.sh",
    "monopipeline": "node scripts/monopipeline.mjs",
    "sync:skills": "bash scripts/sync-agent-skills.sh",
    "check:skills": "bash scripts/sync-agent-skills.sh --check",
    "clean:report": "node scripts/cleanup-dev-storage.mjs",
    "clean": "node scripts/cleanup-dev-storage.mjs --clean",
    "clean:deep": "node scripts/cleanup-dev-storage.mjs --deep"
  },
  "devDependencies": {
    "nx": "^24.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "yarn@4.18.1"
}
