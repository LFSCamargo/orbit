+    if (!open_mapped_dll_file( name, &handle, mapping, image_info, id ))
+    {
+        NtClose( handle );
+        return STATUS_SUCCESS;
+    }
     if ((status = open_unix_file( &handle, name, GENERIC_READ | SYNCHRONIZE, &attr, 0,
