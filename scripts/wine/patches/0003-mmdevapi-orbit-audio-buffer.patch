+/* Orbit: games under Rosetta often miss a 10 ms audio deadline, and Wine's
+ * shared-mode buffer of 3 periods then runs dry and crackles. ORBIT_AUDIO_BUFFER_MS
+ * (set by Orbit per container) raises the smallest shared-mode buffer;
+ * unset keeps Wine's. Clamped to 10..500 ms. Read once. */
+static REFERENCE_TIME orbit_min_shared_duration(void)
+{
+    static LONG cached = -1;
+    WCHAR value[16];
+    LONG ms = InterlockedCompareExchange(&cached, -1, -1);
+
+    if (ms < 0) {
+        DWORD len = GetEnvironmentVariableW(L"ORBIT_AUDIO_BUFFER_MS", value, ARRAY_SIZE(value));
+        ms = (len && len < ARRAY_SIZE(value)) ? wcstol(value, NULL, 10) : 0;
+        if (ms < 0) ms = 0;
+        if (ms > 500) ms = 500;
+        if (ms && ms < 10) ms = 10;
+        InterlockedExchange(&cached, ms);
+    }
+    return (REFERENCE_TIME)ms * 10000;
+}
