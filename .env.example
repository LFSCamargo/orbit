# Copy to .env for local development. Never commit .env.
# SteamGridDB key (steamgriddb.com/profile/preferences): artwork and game themes.
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key_here
# TheGamesDB key: metadata for non-Steam titles.
THE_GAMES_DB_API_KEY=your_thegamesdb_api_key_here
# Aceternity UI Pro token: landing page components.
ACCETERNITY_TOKEN=your_aceternity_token_here
