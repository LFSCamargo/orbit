{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "mainBinaryName": "Orbit",
  "version": "2.6.2",
  "identifier": "com.orbit.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "fullscreen": true,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "public.app-category.games",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/bundled-themes"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMDQ2NjAwMDMzQkJCNzcKUldSM3V6c0RBR1lFMm5LeGxiTUVjRTExem1PRWZTTll1azJvQTdLM21EN1BvaTlRRC9BR0c2Y2EK",
      "endpoints": [
        "https://github.com/LFSCamargo/orbit/releases/latest/download/latest.json"
      ]
    }
  }
}
