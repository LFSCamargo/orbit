    providers.tsx          # QueryClient + theme init
  modules/
    home/
      lib/                 # Shared Home hero selection
      HomePage.tsx
      ThemeHome.tsx        # Renders MacosHome
      components/          # MacosHome (colocated)
      hooks/
    library/
